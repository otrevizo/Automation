# Copy this file to n8n.secrets.env (in the same folder as docker-compose.yml) and fill in real values.
# n8n.secrets.env is git-ignored — never commit real secrets.

# Encryption key n8n uses to encrypt credentials stored in its database.
# Generate your own (e.g. `openssl rand -hex 32`) — do not reuse this example.
N8N_ENCRYPTION_KEY=replace-with-your-own-encryption-key

# Directories filesystem nodes (Read/Write Files from Disk, etc.) are allowed to touch.
# n8n 2.x enforces this allow-list by default — see n8n_how.md's Troubleshooting section.
N8N_RESTRICT_FILE_ACCESS_TO=/data/output
